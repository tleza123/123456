# Public web app configuration. Fill from the matching Firebase environment.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server only. Never use NEXT_PUBLIC_ for any server credential or owner setting.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
OWNER_UID=
SHOP_ID=
APP_ENV=development

# Emulator hosts are intentionally omitted; configure only in local test env.
